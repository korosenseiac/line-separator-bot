# ==============================================================================
# Telegram Video Line Separator Bot Configuration
# ==============================================================================

# [REQUIRED] Your Telegram Bot Token obtained from @BotFather
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# [OPTIONAL] Bot Operation Mode:
# "repost" (default) -> Deletes incoming video and reposts:
#                       [Top Line] -> [Video] -> [Bottom Line]
#                       Requires bot to be Admin with "Delete Messages" permission.
# "append"           -> Non-destructive. Leaves original video untouched and only
#                       sends a line separator below each video.
BOT_MODE=repost

# [OPTIONAL] Line Separator Style Preset:
# Options:
#   - luxury_gold      : ✦ ━━━━━━━━━━━━━━━━━━━━ ✦
#   - minimal_sleek    : ━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#   - diamond_dots     : ◈ ════════════════════ ◈
#   - modern_bar       : ▬▭▬▭▬▭▬▭▬▭▬▭▬▭▬▭▬▭▬▭▬▭▬
#   - aesthetic_stars  : ⋆｡°✩ ━━━━━━━━━━━━━━━━━ ✩°｡⋆
#   - glowing_neon     : ─── ･ ｡ﾟ☆: *.☽ .* :☆ﾟ. ───
#   - clean_double     : ════════════════════════════
#   - custom           : Use CUSTOM_SEPARATOR_TOP / CUSTOM_SEPARATOR_BOTTOM below
SEPARATOR_STYLE=luxury_gold

# [OPTIONAL] Custom separators (used when SEPARATOR_STYLE=custom)
CUSTOM_SEPARATOR_TOP=━━━━━━━━━━━━━━━━━━━━━━━━━━━━
CUSTOM_SEPARATOR_BOTTOM=━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# [OPTIONAL] Restrict bot to specific group chat IDs (comma-separated).
# Leave empty to allow the bot to work in any group/supergroup it is added to.
# Example: ALLOWED_CHAT_IDS=-1001234567890,-1009876543210
ALLOWED_CHAT_IDS=

# [OPTIONAL] Telegram User ID of the Bot Owner.
# When set, only this user can execute the /update command to pull git updates and restart the bot.
# Example: OWNER_ID=987654321
OWNER_ID=

# [OPTIONAL] Additional Telegram User IDs authorized to use /update (comma-separated)
ADMIN_USER_IDS=

# [OPTIONAL] Media types to treat as video
# Set to true or false
INCLUDE_ANIMATIONS=true
INCLUDE_VIDEO_DOCUMENTS=true
INCLUDE_VIDEO_NOTES=true

# [OPTIONAL] Album / Media Group debounce window in seconds
# When multiple videos are sent in an album, wait this duration to group them together.
MEDIA_GROUP_DEBOUNCE_SEC=1.2

# [OPTIONAL] Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
